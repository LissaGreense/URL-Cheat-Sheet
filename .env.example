# Copy this file to `.env` (gitignored) and fill in your keys.
# Bun and Vite both auto-load `.env` from the repo root at dev/test time,
# so any agent or human running `bun --filter @url-cheat-sheet/web dev`
# or `bun --filter @url-cheat-sheet/evals eval <suite>` will pick up
# the values without needing to `export` them per shell.

# Anthropic API key — required for:
#   - The /api/chat endpoint in the local dev server
#   - `bun --filter @url-cheat-sheet/evals eval canary` and any other
#     suite under packages/evals/suites/
#
# Provision a key at https://console.anthropic.com/settings/keys
# Use a separate dev key (not your production key) so the rate-limit
# blast radius stays local.
ANTHROPIC_API_KEY=
